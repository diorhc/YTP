{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true,
      "bracketSameLine": false
    },
    "globals": [
      "window",
      "document",
      "console",
      "localStorage",
      "sessionStorage",
      "location",
      "navigator",
      "history",
      "trustedTypes",
      "queueMicrotask",
      "customElements",
      "unsafeWindow",
      "GM_info",
      "fetch",
      "URL",
      "URLSearchParams",
      "DOMParser",
      "CustomEvent",
      "Event",
      "KeyboardEvent",
      "MouseEvent",
      "StorageEvent",
      "MutationObserver",
      "IntersectionObserver",
      "ResizeObserver",
      "AbortController",
      "requestAnimationFrame",
      "cancelAnimationFrame",
      "requestIdleCallback",
      "getComputedStyle",
      "confirm",
      "performance",
      "Element",
      "HTMLElement",
      "SVGElement",
      "HTMLButtonElement",
      "HTMLInputElement",
      "HTMLIFrameElement",
      "HTMLMediaElement",
      "HTMLSelectElement",
      "Node",
      "Document",
      "DocumentFragment",
      "Window",
      "CustomElementRegistry",
      "setTimeout",
      "clearTimeout",
      "setInterval",
      "clearInterval",
      "globalThis",
      "TextEncoder",
      "TextDecoder",
      "GM_xmlhttpRequest",
      "GM_addElement",
      "GM_addStyle",
      "GM_addValueChangeListener",
      "GM_getValue",
      "GM_setValue",
      "YouTubeUtils",
      "YouTubePlusLogger",
      "YouTubePlusTimeLoop",
      "YouTubePlusScreenshot",
      "YouTubePlusSpeedControl",
      "YouTubePlusDownloadButton",
      "YouTubePlusDownload",
      "YouTubePlusI18n",
      "YouTubeSafeDOM",
      "YouTubePlusCleanupManager",
      "YouTubePlusDesignSystem",
      "YouTubeDOMCache",
      "YouTubePlusDOMCache",
      "YouTubePlusMutationCoordinator",
      "YouTubePlusEventDelegation",
      "YouTubePlusSettingsStore",
      "YouTubePlusSettingsHelpers",
      "YouTubeErrorBoundary",
      "YouTubePlusErrorBoundary",
      "YouTubePerformance",
      "YouTubePlusPerformance",
      "YouTubePlusPip",
      "YouTubePlusThumbnail",
      "YouTubePlusShorts",
      "YouTubePlusPlayall",
      "YouTubePlusPlaylistSearch",
      "YouTubePlusAdBlocker",
      "YouTubePlusComment",
      "YouTubePlusUpdate",
      "YouTubePlusEndscreen",
      "YouTubePlusTimecode",
      "YouTubePlusVoting",
      "YouTubePlusMusic",
      "YouTubePlusReport",
      "YouTubePlusStats",
      "YouTubePlusZoom",
      "closestFromAnchor",
      "_querySelector",
      "$$",
      "findContentsRenderer",
      "isVideoPlaying",
      "nextBrowserTick"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "security": {
        "noGlobalEval": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noConstAssign": "error",
        "noGlobalObjectCalls": "error",
        "noInvalidConstructorSuper": "error",
        "noSelfAssign": "error",
        "noSwitchDeclarations": "error",
        "noUnreachable": "error",
        "noUnsafeOptionalChaining": "error",
        "useExhaustiveDependencies": "off",
        "useIsNan": "error",
        "useYield": "off",
        "noUndeclaredVariables": "warn"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "warn",
        "useDefaultParameterLast": "warn",
        "useExponentiationOperator": "warn",
        "useNodejsImportProtocol": "off",
        "useNumberNamespace": "off",
        "noParameterAssign": "off",
        "noInferrableTypes": "off",
        "useSingleVarDeclarator": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 25
          }
        },
        "noBannedTypes": "off",
        "noForEach": "off",
        "noStaticOnlyClass": "off",
        "noUselessConstructor": "warn",
        "noUselessLoneBlockStatements": "warn",
        "noUselessRename": "warn",
        "noUselessTernary": "warn",
        "noUselessSwitchCase": "warn",
        "useArrowFunction": "off",
        "useFlatMap": "warn",
        "useSimplifiedLogicExpression": "warn"
      },
      "suspicious": {
        "noClassAssign": "error",
        "noCommentText": "off",
        "noCompareNegZero": "error",
        "noConsole": "error",
        "noDebugger": "error",
        "noDoubleEquals": "warn",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noEmptyBlockStatements": "warn",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noImportAssign": "error",
        "noLabelVar": "error",
        "noRedeclare": "error",
        "noSelfCompare": "error",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUnsafeDeclarationMerging": "off",
        "noVar": "error",
        "noAssignInExpressions": "off",
        "noPrototypeBuiltins": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/*.js"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noCommaOperator": "off",
            "noArguments": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "noConsole": "off",
            "noShadowRestrictedNames": "off",
            "useIterableCallbackReturn": "off",
            "noControlCharactersInRegex": "off"
          },
          "correctness": {
            "noInvalidUseBeforeDeclaration": "off"
          }
        }
      }
    },
    {
      "includes": [
        "build.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "useIterableCallbackReturn": "off"
          },
          "style": {
            "useTemplate": "off"
          },
          "complexity": {
            "useSimplifiedLogicExpression": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**/*.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "useTemplate": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noCommaOperator": "off",
            "noArguments": "off",
            "useOptionalChain": "off",
            "useRegexLiterals": "off",
            "useLiteralKeys": "off",
            "noForEach": "off",
            "useFlatMap": "off",
            "useSimplifiedLogicExpression": "off",
            "noUselessSwitchCase": "off",
            "noUselessTernary": "off"
          }
        }
      }
    },
    {
      "includes": [
        "test/**/*.js",
        "e2e/**/*.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "useTemplate": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noCommaOperator": "off",
            "noArguments": "off",
            "useOptionalChain": "off",
            "useRegexLiterals": "off",
            "useLiteralKeys": "off",
            "noForEach": "off",
            "useFlatMap": "off",
            "useSimplifiedLogicExpression": "off",
            "noUselessSwitchCase": "off",
            "noUselessTernary": "off"
          }
        }
      }
    },
    {
      "includes": [
        "build.js",
        "scripts/**/*.js"
      ],
      "javascript": {
        "globals": [
          "process",
          "__dirname",
          "__filename",
          "require",
          "module",
          "exports",
          "Buffer"
        ]
      }
    },
    {
      "includes": [
        "test/**/*.js"
      ],
      "javascript": {
        "globals": [
          "afterAll",
          "afterEach",
          "beforeAll",
          "beforeEach",
          "describe",
          "expect",
          "global",
          "it",
          "jest",
          "test",
          "unsafeWindow",
          "mockLocation",
          "GM_xmlhttpRequest"
        ]
      }
    }
  ],
  "files": {
    "includes": [
      "src/**/*.js",
      "build.js",
      "scripts/**/*.js",
      "test/**/*.js",
      "e2e/**/*.js"
    ],
    "ignoreUnknown": false,
    "maxSize": 2097152
  }
}
