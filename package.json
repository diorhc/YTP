{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "youtubeplus",
  "version": "3.0.0",
  "description": "YouTube enhancement userscript with modular features and shared lifecycle management",
  "private": true,
  "author": "diorhc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diorhc/YTP.git"
  },
  "bugs": {
    "url": "https://github.com/diorhc/YTP/issues"
  },
  "homepage": "https://github.com/diorhc/YTP#readme",
  "keywords": [
    "userscript",
    "youtube",
    "greasemonkey",
    "tampermonkey",
    "browser-extension",
    "video-enhancement",
    "modular-architecture"
  ],
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "node build.js --readable-release",
    "build:watch": "node build.js --watch --readable-release",
    "build:release": "node scripts/release.js build",
    "release:verify": "node scripts/release.js verify",
    "package:source": "node scripts/package-source.js",
    "dev:embed": "node scripts/embedded.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --no-errors-on-unmatched src build.js",
    "lint:fix": "biome check --write --no-errors-on-unmatched src build.js",
    "lint:tools": "biome check --no-errors-on-unmatched scripts test e2e",
    "lint:tools:fix": "biome check --write --no-errors-on-unmatched scripts test e2e",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "check:scope": "node scripts/check-push-scope.js",
    "check:security": "node scripts/security-innerhtml-scan.js && node scripts/lint-custom-rules.js && node scripts/check-secrets.js",
    "check:locales": "node scripts/check-locale-parity.js --ci && node scripts/audit-i18n.js --ci && node scripts/sync-available-languages.js --ci",
    "check:slop": "node scripts/lint-custom-rules.js --report",
    "check:code-ratchet": "node scripts/check-code-ratchet.js",
    "check:css-ratchet": "node scripts/check-css-ratchet.js",
    "check:duplication": "jscpd src --max-lines 100000 --min-lines 5 --min-tokens 50 --reporters console",
    "check:supabase": "node scripts/check-supabase-contract.js",
    "check:facade-usage": "node scripts/check-facade-usage.js",
    "sync:locales": "node scripts/sync-available-languages.js --write && node scripts/sync-locale-metadata.js",
    "version": "npm run sync:locales",
    "update:badges": "node scripts/update-greasyfork-badges.js https://greasyfork.org/scripts/537017-youtube README.md",
    "knip": "knip --config knip.json",
    "test": "npm run build:release && npm run test:unit",
    "test:unit": "jest --maxWorkers=2",
    "test:ci": "jest --coverage --maxWorkers=2 && node scripts/check-coverage-ratchet.js",
    "test:e2e": "playwright test",
    "test:e2e:tabview-coverage": "node scripts/run-tabview-coverage.js",
    "test:release-integration": "node scripts/run-release-integration.js",
    "test:source-package-integration": "node scripts/run-source-package-integration.js",
    "budget:startup": "node scripts/run-startup-budget.js",
    "security": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run typecheck:scripts && npm run lint && npm run lint:tools && npm run check:scope && npm run check:security && npm run check:locales && npm run check:slop && npm run check:duplication && npm run check:code-ratchet && npm run check:css-ratchet && npm run check:facade-usage && npm run knip && node scripts/check-version-consistency.js && npm run build:release && npm run test:ci && npm run release:verify",
    "ci": "npm run verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "acorn": "^8.19.0",
    "chokidar": "^5.0.0",
    "fast-check": "^4.10.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.2",
    "jscpd": "5.4.1",
    "jsdom": "26.1.0",
    "knip": "^6.41.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "ws": "^8.20.1",
    "yauzl": "^3.2.1"
  }
}
